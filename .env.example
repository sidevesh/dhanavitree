PORT=3000
# Local SQLite database and private files live under this directory. Render uses /var/data.
DATA_DIR=data
# Text / vision provider: openai (default) or meta. Both enable web research and images on the same key.
LLM_PROVIDER=openai
# Optional text / vision provider. Use an API root ending in /v1, not /chat/completions.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1
OWNER_MODEL=
CUSTOMER_MODEL=
VISION_MODEL=
# OpenAI defaults to the text base URL/key and gpt-image-2 (Meta: muse-image-1.0). Overrides are optional.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional standalone WhatsApp webhook. All five fields required to enable it.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# AgenticOrg managed roles. IDs are configured in AgenticOrg; never exposed publicly.
# API-key auth is checked on /agents/{id}/run; agent-list/schema endpoints may require session auth.
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_API_KEY=
AGENTICORG_OWNER_AGENT_ID=
AGENTICORG_CUSTOMER_AGENT_ID=
AGENTICORG_ORDER_AGENT_ID=
# Optional fallback agent used for any unmapped role.
AGENTICORG_AGENT_ID=
# Pine Labs Plural UAT. No simulated payment links are issued when keys are absent.
PUBLIC_URL=http://localhost:3000
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
# Voice conversations (Pipecat service in voice/). Both values enable the mic button.
# Generate a secret with: openssl rand -hex 32
VOICE_URL=http://127.0.0.1:7860
VOICE_INTERNAL_SECRET=
# Optional voice settings. The voice service uses LLM_API_KEY for OpenAI speech unless VOICE_OPENAI_API_KEY is set.
VOICE_OPENAI_API_KEY=
VOICE_STT_MODEL=gpt-4o-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral
# STUN/TURN servers as JSON. A TURN relay is required when the voice service is not directly reachable over UDP.
VOICE_ICE_SERVERS=
