PORT=3000
# Choose a random value; enter the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# Meta app settings > Basic > App secret (used to validate webhook signatures).
META_APP_SECRET=
# WhatsApp > API Setup: access token and Phone number ID (not the phone number).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to a currently supported Graph API version shown in Meta's API Setup.
WHATSAPP_GRAPH_VERSION=v23.0
