# Customer chat: set OPENAI_API_KEY (used if present) or ANTHROPIC_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Public URL of this app (Render/Replit URL), used in payment-link callbacks
PUBLIC_URL=http://localhost:3000
OWNER_KEY=change-me

# Pine Labs Plural (UAT). Leave empty to run in TEST MODE.
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=

# AgenticOrg (hackathon tenant). Use an org API key with agents.execute if an admin gives you one,
# otherwise the app logs in with the team member's account.
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_AGENT_ID=
AGENTICORG_API_KEY=
AGENTICORG_EMAIL=
AGENTICORG_PASSWORD=
