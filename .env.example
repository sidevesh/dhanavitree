PORT=3000
# Local SQLite database and private files live under this directory. Render uses /var/data.
DATA_DIR=data
# Optional text / vision provider. Use an API root ending in /v1, not /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
OWNER_MODEL=
CUSTOMER_MODEL=
VISION_MODEL=
# Optional Tavily search API key.
SEARCH_API_KEY=
# Optional OpenAI Images-compatible endpoint (not a chat-only gateway).
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
# Optional standalone WhatsApp webhook. All five fields required to enable it.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
