PORT=3000
# Local SQLite database and private files live under this directory. Render uses /var/data.
DATA_DIR=data
# Text / vision provider: meta enables native web research using the same API key.
LLM_PROVIDER=meta
# Optional text / vision provider. Use an API root ending in /v1, not /chat/completions.
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.2-contributor
OWNER_MODEL=
CUSTOMER_MODEL=
VISION_MODEL=
# Meta defaults to the text base URL/key and muse-image-1.0. Overrides are optional.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=muse-image-1.0
# Optional standalone WhatsApp webhook. All five fields required to enable it.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# AgenticOrg managed roles. IDs are configured in AgenticOrg; never exposed publicly.
# API-key auth is checked on /agents/{id}/run; agent-list/schema endpoints may require session auth.
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
AGENTICORG_API_KEY=
AGENTICORG_OWNER_AGENT_ID=
AGENTICORG_CUSTOMER_AGENT_ID=
AGENTICORG_ORDER_AGENT_ID=
# Optional fallback agent used for any unmapped role.
AGENTICORG_AGENT_ID=
# Pine Labs Plural UAT. No simulated payment links are issued when keys are absent.
PUBLIC_URL=http://localhost:3000
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=
