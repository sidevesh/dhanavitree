{
  "name": "dhanavitree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "design:export": "node scripts/export-design.mjs",
    "voice:setup": "python3 -m venv voice/.venv && voice/.venv/bin/pip install -r voice/requirements.txt",
    "voice": "voice/.venv/bin/python voice/bot.py"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
